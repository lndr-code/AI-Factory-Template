# =============================================================================
# AI Factory — Environment Configuration
#
# Auth model:
#   API-key based  → Gemini (Architect/Reviewer), OpenAI (Critic)
#   Login-based    → Claude Code (primary builder), Codex CLI (fallback builder)
#
# After starting the container for the first time:
#   docker exec --user appuser -it <COMPOSE_PROJECT_NAME>-dev-1 claude login
#   docker exec --user appuser -it <COMPOSE_PROJECT_NAME>-dev-1 codex auth login
#   (Alternatively, set OPENAI_API_KEY to use API auth for Codex as well.)
#   Replace <COMPOSE_PROJECT_NAME> with the value set below (defaults to directory name).
# =============================================================================

# === Project identity ===
# Sets the Docker Compose project name → determines container names:
#   <COMPOSE_PROJECT_NAME>-dev-1   (orchestrator)
#   <COMPOSE_PROJECT_NAME>-ui-1    (frontend)
# Must be unique per project when running multiple projects in parallel.
# Defaults to the directory name if not set.
COMPOSE_PROJECT_NAME=ai-factory

# === API-key based (always required) ===
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here   # Used for Critic; also accepted by Codex fallback

# === Role-specific model configuration ===

# Architect and Reviewer use Gemini
GEMINI_ARCHITECT_MODEL=gemini-2.5-pro
GEMINI_REVIEW_MODEL=gemini-2.5-pro

# Critic uses OpenAI — update to the latest available reasoning model
OPENAI_CRITIC_MODEL=gpt-5.4-mini

# === Feature flags ===

# Set CODEX_ENABLED=true to activate the Codex CLI fallback builder.
# Requires: codex binary in PATH (installed in Docker image by default).
# Auth: either OPENAI_API_KEY above, or run `codex auth login` interactively.
CODEX_ENABLED=false

# Set to your project's test/build command to block commits on failure
VALIDATION_COMMAND=
VALIDATION_TIMEOUT=300
# Examples:
# VALIDATION_COMMAND=pytest tests/
# VALIDATION_COMMAND=npm test
# VALIDATION_COMMAND=make validate

# === Timeouts and retries ===
CLAUDE_TIMEOUT=600
CODEX_TIMEOUT=300
MAX_TASK_RETRIES=2
MAX_REVIEW_RETRIES=2
MAX_VALIDATION_RETRIES=2
PROJECT_ROOT=/workspace

# === Codex fallback file access ===
# Comma-separated list of root directories the Codex builder may write to
# when using the legacy file-block path. Not used by the Codex CLI builder.
# BUILDER_FILE_ALLOWED_ROOTS=src,tests,docs
